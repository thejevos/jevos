{
  "name": "@jevos/core",
  "version": "0.1.0",
  "description": "Decision and policy runtime for autonomous agents, powered by Jev.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "ai-agents",
    "agent-control",
    "jev",
    "guardrails",
    "policy",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thejevos/jevos.git"
  },
  "homepage": "https://thejevos.com"
}
